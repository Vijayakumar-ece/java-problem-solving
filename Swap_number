package day1;
import java.util.*;
public class swapping 
{

	public static void main(String[] args) 
	{
	Scanner sc = new Scanner(System.in);
	int a = 20;
	int b = 30;
	System.out.println("before swapping a= " +a+"b= " +b);
	a = a+b;
	b = a-b;
	a = a-b;
	System.out.println("after swapping a= " +a+ "b= " +b);
	sc.close();

	}

}
